<?xml version="1.0" encoding="UTF-8"?>
<!--
  Process application descriptor, picked up because of @EnableProcessApplication.

  MIGRATION HOTSPOT: the namespace http://www.camunda.org/schema/1.0/ProcessApplication has to
  become the Operaton one. "additionalResourceSuffixes=form" is needed so that the Camunda
  Forms file (approve-order.form) is deployed together with the BPMN - process application
  scanning only picks up .bpmn/.cmmn/.dmn by default.
-->
<process-application
    xmlns="http://www.camunda.org/schema/1.0/ProcessApplication"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <process-archive name="order-fulfillment">
    <properties>
      <property name="isDeleteUponUndeploy">false</property>
      <property name="isScanForProcessDefinitions">true</property>
      <property name="additionalResourceSuffixes">form</property>
    </properties>
  </process-archive>

</process-application>
