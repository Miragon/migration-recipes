# Environment for the order-fulfillment container (docker run --env-file ops/docker/app.env ...)
#
# MIGRATION HOTSPOT (non-Java config): Spring Boot relaxed binding maps CAMUNDA_BPM_* env vars
# to camunda.bpm.* properties. After the migration they must be OPERATON_BPM_* - otherwise
# they are silently ignored (e.g. no admin user, default webapp path /operaton).
# The same applies to Helm values, Kubernetes ConfigMaps/Secrets and CI/CD variables.
CAMUNDA_BPM_ADMIN_USER_ID=admin
CAMUNDA_BPM_ADMIN_USER_PASSWORD=change-me
CAMUNDA_BPM_WEBAPP_APPLICATION_PATH=/camunda
CAMUNDA_BPM_JOB_EXECUTION_CORE_POOL_SIZE=5
CAMUNDA_BPM_DATABASE_SCHEMA_UPDATE=false
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/camunda
SPRING_DATASOURCE_USERNAME=camunda
SPRING_DATASOURCE_PASSWORD=camunda
