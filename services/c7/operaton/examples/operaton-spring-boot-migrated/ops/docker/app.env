# Environment for the order-fulfillment container (docker run --env-file ops/docker/app.env ...)
#
# MIGRATED (non-Java config): Spring Boot relaxed binding maps OPERATON_BPM_* env vars to operaton.bpm.*.
# The former CAMUNDA_BPM_* names would be ignored silently - migration.LegacyCamundaConfigGuard now
# stops the start if one is left (also in Helm values, ConfigMaps/Secrets and CI/CD variables).
# Decision D6: the webapps stay at /camunda. Decision D8: no automatic DDL at the cut-over.
OPERATON_BPM_ADMIN_USER_ID=admin
OPERATON_BPM_ADMIN_USER_PASSWORD=change-me
OPERATON_BPM_WEBAPP_APPLICATION_PATH=/camunda
OPERATON_BPM_JOB_EXECUTION_CORE_POOL_SIZE=5
OPERATON_BPM_DATABASE_SCHEMA_UPDATE=false
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/camunda
SPRING_DATASOURCE_USERNAME=camunda
SPRING_DATASOURCE_PASSWORD=camunda
