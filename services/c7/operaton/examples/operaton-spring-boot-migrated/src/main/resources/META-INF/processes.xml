<?xml version="1.0" encoding="UTF-8"?>
<!--
  Process application descriptor, picked up because of @EnableProcessApplication.

  MIGRATED: the namespace http://www.camunda.org/schema/1.0/ProcessApplication became
  http://www.operaton.org/schema/1.0/ProcessApplication (official recipe). Operaton refuses to start
  with the old one ("cvc-elt.1.a: Cannot find the declaration of element 'process-application'").
  "additionalResourceSuffixes=form" deploys the form-js file (approve-order.form) together with the
  BPMN - process application scanning only picks up .bpmn/.cmmn/.dmn by default.
-->
<process-application
    xmlns="http://www.operaton.org/schema/1.0/ProcessApplication"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <process-archive name="order-fulfillment">
    <properties>
      <property name="isDeleteUponUndeploy">false</property>
      <property name="isScanForProcessDefinitions">true</property>
      <property name="additionalResourceSuffixes">form</property>
    </properties>
  </process-archive>

</process-application>
