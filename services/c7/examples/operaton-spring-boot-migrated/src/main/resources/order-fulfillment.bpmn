<?xml version="1.0" encoding="UTF-8"?>
<!--
  Order fulfillment process (migrated to Operaton).

  MIGRATED in this file (changing it deploys a new process definition version; instances on the old
  version keep the old script and form key until they are migrated - see MIGRATION_REPORT.md):
  - inline Groovy script: import org.camunda.spin.Spin -> org.operaton.spin.Spin
    (starterpack.operaton.ScriptImports; the old import deploys fine but fails at runtime)
  - camunda:formKey prefix camunda-forms: -> operaton-forms: (starterpack.operaton.FormKeys, decision D4)
  KEPT on purpose (decision D3):
  - xmlns:camunda="http://camunda.org/schema/1.0/bpmn" + camunda:* attributes/extension elements
    (Operaton reads the camunda namespace; Camunda Modeler keeps working)
  - modeler:executionPlatform="Camunda Platform" (Modeler tooling only)
  - camunda:class execution listener (FQCN of own code, unchanged)
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_OrderFulfillment"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.28.0"
                  modeler:executionPlatform="Camunda Platform"
                  modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="order-fulfillment" name="Order fulfillment" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:extensionElements>
      <camunda:executionListener class="com.example.orders.listener.OrderAuditListener" event="start" />
      <camunda:executionListener class="com.example.orders.listener.OrderAuditListener" event="end" />
    </bpmn:extensionElements>

    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order received">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="orderId" label="Order id" type="string">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="customerType" label="Customer type" type="enum" defaultValue="REGULAR">
            <camunda:value id="REGULAR" name="Regular" />
            <camunda:value id="VIP" name="VIP" />
          </camunda:formField>
          <camunda:formField id="amount" label="Amount (EUR)" type="long">
            <camunda:validation>
              <camunda:constraint name="required" />
              <camunda:constraint name="min" config="1" />
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToCheckInventory</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_CheckInventory" name="Check inventory" camunda:asyncBefore="true" camunda:delegateExpression="${checkInventoryDelegate}">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R3/PT1M</camunda:failedJobRetryTimeCycle>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCheckInventory</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDetermineDiscount</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Task_DetermineDiscount" name="Determine discount" camunda:resultVariable="discount" camunda:decisionRef="order-discount" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_ToDetermineDiscount</bpmn:incoming>
      <bpmn:outgoing>Flow_ToBuildSummary</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:scriptTask id="Task_BuildSummary" name="Build order summary" scriptFormat="groovy">
      <bpmn:incoming>Flow_ToBuildSummary</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApprovalGateway</bpmn:outgoing>
      <bpmn:script><![CDATA[
// MIGRATED: was "import org.camunda.spin.Spin". Scripts are compiled when a token reaches them,
// so the old import deployed fine and failed at runtime ("unable to resolve class ...Spin").
// Tip: only S() is injected into Groovy scripts (JSON()/XML() are not). Package-free and verified with a
// variant of this script on Camunda 7.24, Operaton 1.1.5 and 2.1.5: S('{}').prop('orderId', orderId)...
import org.operaton.spin.Spin

def summary = Spin.JSON([
    orderId         : orderId,
    customerType    : customerType,
    amount          : amount,
    discount        : discount,
    approvalRequired: amount > 1000
])
execution.setVariable('orderSummary', summary)]]></bpmn:script>
    </bpmn:scriptTask>

    <bpmn:exclusiveGateway id="Gateway_ApprovalRequired" name="Approval required?">
      <bpmn:incoming>Flow_ToApprovalGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovalNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_ApproveOrder" name="Approve order" camunda:formKey="operaton-forms:deployment:approve-order.form" camunda:candidateGroups="order-ops">
      <bpmn:incoming>Flow_ApprovalYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApprovedGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="BoundaryEvent_Reminder" name="24h" cancelActivity="false" attachedToRef="Task_ApproveOrder">
      <bpmn:outgoing>Flow_ToSendReminder</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Reminder">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_SendReminder" name="Remind approvers" camunda:expression="${execution.setVariable('reminderSent', true)}">
      <bpmn:incoming>Flow_ToSendReminder</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReminderSent</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_ReminderSent" name="Reminder sent">
      <bpmn:incoming>Flow_ToReminderSent</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?">
      <bpmn:incoming>Flow_ToApprovedGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_OrderRejected" name="Order rejected">
      <bpmn:incoming>Flow_ApprovedNo</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_ApprovalNo</bpmn:incoming>
      <bpmn:incoming>Flow_ApprovedYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ToShipOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_ShipOrder" name="Ship order" camunda:type="external" camunda:topic="ship-order">
      <bpmn:incoming>Flow_ToShipOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_ToOrderShipped</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_OrderShipped" name="Order shipped">
      <bpmn:incoming>Flow_ToOrderShipped</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_ToCheckInventory" sourceRef="StartEvent_OrderReceived" targetRef="Task_CheckInventory" />
    <bpmn:sequenceFlow id="Flow_ToDetermineDiscount" sourceRef="Task_CheckInventory" targetRef="Task_DetermineDiscount" />
    <bpmn:sequenceFlow id="Flow_ToBuildSummary" sourceRef="Task_DetermineDiscount" targetRef="Task_BuildSummary" />
    <bpmn:sequenceFlow id="Flow_ToApprovalGateway" sourceRef="Task_BuildSummary" targetRef="Gateway_ApprovalRequired" />
    <bpmn:sequenceFlow id="Flow_ApprovalYes" name="amount &gt; 1000" sourceRef="Gateway_ApprovalRequired" targetRef="Task_ApproveOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 1000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApprovalNo" name="amount &lt;= 1000" sourceRef="Gateway_ApprovalRequired" targetRef="Gateway_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &lt;= 1000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToApprovedGateway" sourceRef="Task_ApproveOrder" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_ApprovedYes" name="yes" sourceRef="Gateway_Approved" targetRef="Gateway_Merge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApprovedNo" name="no" sourceRef="Gateway_Approved" targetRef="EndEvent_OrderRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToSendReminder" sourceRef="BoundaryEvent_Reminder" targetRef="Task_SendReminder" />
    <bpmn:sequenceFlow id="Flow_ToReminderSent" sourceRef="Task_SendReminder" targetRef="EndEvent_ReminderSent" />
    <bpmn:sequenceFlow id="Flow_ToShipOrder" sourceRef="Gateway_Merge" targetRef="Task_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_ToOrderShipped" sourceRef="Task_ShipOrder" targetRef="EndEvent_OrderShipped" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_OrderFulfillment">
    <bpmndi:BPMNPlane id="BPMNPlane_OrderFulfillment" bpmnElement="order-fulfillment">
      <bpmndi:BPMNShape id="StartEvent_OrderReceived_di" bpmnElement="StartEvent_OrderReceived">
        <dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="134" y="225" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckInventory_di" bpmnElement="Task_CheckInventory">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DetermineDiscount_di" bpmnElement="Task_DetermineDiscount">
        <dc:Bounds x="390" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuildSummary_di" bpmnElement="Task_BuildSummary">
        <dc:Bounds x="540" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ApprovalRequired_di" bpmnElement="Gateway_ApprovalRequired" isMarkerVisible="true">
        <dc:Bounds x="695" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="674" y="145" width="92" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveOrder_di" bpmnElement="Task_ApproveOrder">
        <dc:Bounds x="800" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendReminder_di" bpmnElement="Task_SendReminder">
        <dc:Bounds x="900" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ReminderSent_di" bpmnElement="EndEvent_ReminderSent">
        <dc:Bounds x="1052" y="472" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1035" y="515" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Approved_di" bpmnElement="Gateway_Approved" isMarkerVisible="true">
        <dc:Bounds x="955" y="345" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="954" y="402" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_OrderRejected_di" bpmnElement="EndEvent_OrderRejected">
        <dc:Bounds x="962" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1005" y="273" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="1095" y="345" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShipOrder_di" bpmnElement="Task_ShipOrder">
        <dc:Bounds x="1200" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_OrderShipped_di" bpmnElement="EndEvent_OrderShipped">
        <dc:Bounds x="1352" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1336" y="395" width="69" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent_Reminder_di" bpmnElement="BoundaryEvent_Reminder">
        <dc:Bounds x="832" y="392" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="871" y="430" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_ToCheckInventory_di" bpmnElement="Flow_ToCheckInventory">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDetermineDiscount_di" bpmnElement="Flow_ToDetermineDiscount">
        <di:waypoint x="340" y="200" />
        <di:waypoint x="390" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToBuildSummary_di" bpmnElement="Flow_ToBuildSummary">
        <di:waypoint x="490" y="200" />
        <di:waypoint x="540" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToApprovalGateway_di" bpmnElement="Flow_ToApprovalGateway">
        <di:waypoint x="640" y="200" />
        <di:waypoint x="695" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovalYes_di" bpmnElement="Flow_ApprovalYes">
        <di:waypoint x="720" y="225" />
        <di:waypoint x="720" y="370" />
        <di:waypoint x="800" y="370" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="728" y="283" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovalNo_di" bpmnElement="Flow_ApprovalNo">
        <di:waypoint x="745" y="200" />
        <di:waypoint x="1120" y="200" />
        <di:waypoint x="1120" y="345" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="892" y="182" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToApprovedGateway_di" bpmnElement="Flow_ToApprovedGateway">
        <di:waypoint x="900" y="370" />
        <di:waypoint x="955" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovedYes_di" bpmnElement="Flow_ApprovedYes">
        <di:waypoint x="1005" y="370" />
        <di:waypoint x="1095" y="370" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1041" y="352" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ApprovedNo_di" bpmnElement="Flow_ApprovedNo">
        <di:waypoint x="980" y="345" />
        <di:waypoint x="980" y="298" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="988" y="315" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToSendReminder_di" bpmnElement="Flow_ToSendReminder">
        <di:waypoint x="850" y="428" />
        <di:waypoint x="850" y="490" />
        <di:waypoint x="900" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToReminderSent_di" bpmnElement="Flow_ToReminderSent">
        <di:waypoint x="1000" y="490" />
        <di:waypoint x="1052" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToShipOrder_di" bpmnElement="Flow_ToShipOrder">
        <di:waypoint x="1145" y="370" />
        <di:waypoint x="1200" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToOrderShipped_di" bpmnElement="Flow_ToOrderShipped">
        <di:waypoint x="1300" y="370" />
        <di:waypoint x="1352" y="370" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
